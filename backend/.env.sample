# Database
SUPABASE_CONNECTION_STRING=postgresql://postgres.[project-ref]:[password]@aws-0-us-west-2.pooler.supabase.com:6543/postgres
SUPABASE_DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# App
NODE_ENV=development
PORT=4000

# Supabase
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Client
CLIENT_URL=http://localhost:5173

# Cloudflare Turnstile (contact form)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Email (Gmail SMTP)
EMAIL_NAME=Student Bidding
EMAIL_MAIL=Student Bidding<your_email@gmail.com>
EMAIL_PASS=your_gmail_app_password
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465

# JWT
JWT_SECRET=your_jwt_secret_key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Cloudbeds/myallocator OTA Build-To-Us channel — issued by Cloudbeds after
# the partner credentialing form is approved
MYALLOCATOR_SHARED_SECRET=your_myallocator_shared_secret
MYALLOCATOR_OTA_CID=your_myallocator_channel_id

# Upstash Redis — used for API rate limiting. Create a free database at
# https://console.upstash.com and copy the REST URL/token from there.
# Rate limiting fails open (disabled, not blocked) if these are unset.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
