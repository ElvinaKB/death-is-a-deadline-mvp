<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Booking Confirmed</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f4;font-family:Arial,Helvetica,sans-serif;color:#111827;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f4f4f4;">
<tr><td align="center" style="padding:20px 10px;">

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:720px;width:100%;background:#ffffff;border-collapse:separate;border-spacing:0;">

  <!-- HEADER -->
  <tr><td style="background:#111111;padding:24px 28px 18px;color:#ffffff;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr>
      <td align="left" style="font-family:Georgia,'Times New Roman',serif;color:#d6a73a;font-size:30px;letter-spacing:3px;">DEADLINE</td>
      <td align="right" style="color:#ffffff;font-size:11px;letter-spacing:4px;text-transform:uppercase;">YOUR RESERVATION</td>
    </tr></table>
  </td></tr>

  <tr><td align="center" style="background:#171717;padding:34px 24px 28px;color:#ffffff;">
    <div style="font-family:Georgia,'Times New Roman',serif;font-size:36px;line-height:1.15;margin-bottom:14px;">You&rsquo;re Booked!</div>
    <div style="font-size:12px;letter-spacing:7px;text-transform:uppercase;margin-bottom:16px;">RESERVATION CONFIRMED</div>
    <div style="width:54px;height:2px;background:#d6a73a;margin:0 auto;"></div>
  </td></tr>

  <!-- INTRO -->
  <tr><td style="padding:26px 28px 16px;">
    <div style="font-size:17px;margin-bottom:10px;">Hi <%= studentName %>,</div>
    <div style="font-size:16px;line-height:1.6;">
      Great news &mdash; your stay at <strong><%= placeName %></strong> is officially booked. Your bid was accepted and your card has been charged.
    </div>
  </td></tr>

  <!-- BOOKING CARD -->
  <tr><td style="padding:0 28px 22px;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;">
      <tr><td colspan="2" style="padding:18px 20px;background:#f7f8fa;">
        <table role="presentation" width="100%"><tr>
          <td style="font-size:13px;font-weight:bold;letter-spacing:4px;">YOUR TRIP</td>
          <td align="right" style="font-size:13px;color:#475569;">Reservation: <strong><%= reservationNumber %></strong></td>
        </tr></table>
      </td></tr>

      <tr>
        <!-- LEFT: trip details -->
        <td width="50%" valign="top" style="padding:22px;border-right:1px solid #e5e7eb;">
          <div style="margin-bottom:16px;"><div style="font-size:13px;color:#64748b;">Property</div><div style="font-size:15px;font-weight:bold;"><%= placeName %></div><div style="font-size:13px;color:#475569;"><%= placeCity %>, <%= placeCountry %></div></div>
          <div style="margin-bottom:16px;">
            <div style="font-size:13px;color:#64748b;">Check-in</div>
            <div style="font-size:15px;font-weight:bold;margin-bottom:4px;"><%= checkInDate %></div>
            <% if (googleCalendarUrl) { %>
            <a href="<%= googleCalendarUrl %>" target="_blank" style="color:#1264d8;text-decoration:underline;font-size:14px;">Add trip to Google Calendar</a>
            <% } %>
          </div>
          <div style="margin-bottom:16px;"><div style="font-size:13px;color:#64748b;">Check-out</div><div style="font-size:15px;font-weight:bold;"><%= checkOutDate %></div></div>
          <div><div style="font-size:13px;color:#64748b;">Total Nights</div><div style="font-size:15px;"><%= totalNights %></div></div>
        </td>

        <!-- RIGHT: payment -->
        <td width="50%" valign="top" style="padding:22px;">
          <div style="font-size:13px;font-weight:bold;letter-spacing:4px;margin-bottom:24px;">PAYMENT SUMMARY</div>
          <% if (typeof commissionOnly !== 'undefined' && commissionOnly) { %>
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
            <tr><td style="padding-bottom:12px;font-size:14px;">Room Total</td><td align="right" style="padding-bottom:12px;font-size:14px;">$<%= roomRate %></td></tr>
            <tr><td style="padding-bottom:12px;font-size:14px;">Booking fee charged today</td><td align="right" style="padding-bottom:12px;font-size:14px;">$<%= commissionAmount %></td></tr>
            <tr><td style="background:#f7f8fa;padding:14px 10px;font-size:15px;font-weight:bold;">Due at property</td><td align="right" style="background:#f7f8fa;padding:14px 10px;font-size:20px;font-weight:bold;">$<%= hotelBalance %></td></tr>
            <tr><td style="padding-top:14px;font-size:14px;">+ Taxes &amp; fees</td><td align="right" style="padding-top:14px;font-size:14px;">Collected at check-in</td></tr>
          </table>
          <div style="background:#e8f8ef;border-radius:10px;padding:16px 18px;margin-top:20px;color:#075b35;font-size:14px;line-height:1.5;">
            <strong>You paid $<%= commissionAmount %> today.</strong> Pay the remaining $<%= hotelBalance %> + taxes at the property at check-in. Bring a valid government-issued ID and a card for incidentals.
          </div>
          <% } else { %>
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
            <tr><td style="padding-bottom:12px;font-size:14px;">Price per Night</td><td align="right" style="padding-bottom:12px;font-size:14px;">$<%= bidPerNight %></td></tr>
            <tr><td style="padding-bottom:12px;font-size:14px;">Room Total</td><td align="right" style="padding-bottom:12px;font-size:14px;">$<%= totalAmount %></td></tr>
            <% if (mandatoryFeeAmount) { %>
            <tr><td style="padding-bottom:12px;font-size:14px;">Mandatory Hotel Fee</td><td align="right" style="padding-bottom:12px;font-size:14px;">$<%= mandatoryFeeAmount %></td></tr>
            <% } %>
            <tr><td style="background:#f7f8fa;padding:14px 10px;font-size:15px;font-weight:bold;">Total Charged</td><td align="right" style="background:#f7f8fa;padding:14px 10px;font-size:20px;font-weight:bold;">$<%= grandTotal %></td></tr>
          </table>
          <div style="background:#e8f8ef;border-radius:10px;padding:16px 18px;margin-top:20px;color:#075b35;font-size:14px;line-height:1.5;">
            <strong>Paid in full.</strong> Just bring a valid government-issued ID and a card for any incidentals at check-in.
          </div>
          <% } %>
        </td>
      </tr>

      <% if (placeFullAddress || placeContactEmail || placeContactPhone) { %>
      <tr><td colspan="2" style="border-top:1px solid #e5e7eb;padding:20px 22px;">
        <div style="font-size:13px;font-weight:bold;letter-spacing:4px;margin-bottom:14px;">HOTEL CONTACT</div>
        <% if (placeFullAddress) { %>
        <div style="margin-bottom:10px;font-size:14px;"><%= placeFullAddress %><% if (mapsUrl) { %> &nbsp;<a href="<%= mapsUrl %>" style="color:#1264d8;text-decoration:underline;">Get directions &rarr;</a><% } %></div>
        <% } %>
        <% if (placeContactPhone) { %>
        <div style="margin-bottom:6px;font-size:14px;">Phone: <a href="tel:<%= placeContactPhone %>" style="color:#111827;text-decoration:none;"><%= placeContactPhone %></a></div>
        <% } %>
        <% if (placeContactEmail) { %>
        <div style="font-size:14px;">Email: <a href="mailto:<%= placeContactEmail %>" style="color:#1264d8;text-decoration:underline;"><%= placeContactEmail %></a></div>
        <% } %>
      </td></tr>
      <% } %>
    </table>
  </td></tr>

  <!-- CTA -->
  <tr><td align="center" style="padding:0 28px 26px;">
    <a href="<%= dashboardUrl %>" style="display:inline-block;background:#e7b53c;color:#111111;font-size:16px;font-weight:bold;text-decoration:none;padding:15px 36px;border-radius:8px;">View Your Bookings &rarr;</a>
  </td></tr>

  <!-- FOOTER -->
  <tr><td style="border-top:1px solid #e5e7eb;padding:24px 28px 30px;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr>
      <td valign="top">
        <div style="font-family:Georgia,'Times New Roman',serif;color:#d6a73a;font-size:24px;letter-spacing:3px;">DEADLINE</div>
        <div style="font-size:8px;letter-spacing:3px;color:#475569;margin-top:3px;">LIFE'S SHORT. TRAVEL NOW.</div>
      </td>
      <td align="right" valign="top" style="font-size:13px;line-height:1.55;color:#475569;">
        Questions?<br>
        <a href="https://www.deadlinetravel.com" style="color:#c49322;">deadlinetravel.com</a>
      </td>
    </tr></table>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
