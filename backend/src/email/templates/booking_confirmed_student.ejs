<%- include('./partials/deadline-head', {
  title: 'Booking Confirmed',
  heading: 'Your reservation is confirmed!',
  badgeText: '✓ Confirmed'
}) %>

<p class="intro">Hi <%= studentName %>,</p>

<p>Great news &mdash; your stay at <strong><%= placeName %></strong> is officially booked. Your bid was accepted and your card has been charged successfully.</p>

<table class="detail-table" role="presentation" cellpadding="0" cellspacing="0" border="0">
  <tr><td class="label">Reservation #</td><td class="value"><%= reservationNumber %></td></tr>
  <tr><td class="label">Property</td><td class="value"><%= placeName %></td></tr>
  <tr><td class="label">Location</td><td class="value"><%= placeCity %>, <%= placeCountry %></td></tr>
  <tr><td class="label">Check-in</td><td class="value"><%= checkInDate %></td></tr>
  <tr><td class="label">Check-out</td><td class="value"><%= checkOutDate %></td></tr>
  <tr><td class="label">Total Nights</td><td class="value"><%= totalNights %></td></tr>
  <tr><td class="label">Price per Night</td><td class="value">$<%= bidPerNight %></td></tr>
  <tr><td class="label">Room Total</td><td class="value">$<%= totalAmount %></td></tr>
  <% if (mandatoryFeeAmount) { %>
  <tr><td class="label">Mandatory Hotel Fee</td><td class="value">$<%= mandatoryFeeAmount %></td></tr>
  <% } %>
  <tr class="total-row"><td>Total Charged</td><td class="value">$<%= grandTotal %></td></tr>
</table>

<% if (placeFullAddress || placeContactEmail || placeContactPhone) { %>
<table class="detail-table" role="presentation" cellpadding="0" cellspacing="0" border="0">
  <tr><th colspan="2">Hotel Contact Information</th></tr>
  <% if (placeFullAddress) { %>
  <tr>
    <td class="label">Address</td>
    <td class="value">
      <%= placeFullAddress %>
      <% if (mapsUrl) { %>
      <br />
      <a href="<%= mapsUrl %>" style="color: #6366f1; font-weight: 600; font-size: 13px; text-decoration: none;">Get directions &rarr;</a>
      <% } %>
    </td>
  </tr>
  <% } %>
  <% if (placeContactEmail) { %>
  <tr>
    <td class="label">Email</td>
    <td class="value"><a href="mailto:<%= placeContactEmail %>" style="color: #374151; text-decoration: none;"><%= placeContactEmail %></a></td>
  </tr>
  <% } %>
  <% if (placeContactPhone) { %>
  <tr>
    <td class="label">Phone</td>
    <td class="value"><a href="tel:<%= placeContactPhone %>" style="color: #374151; text-decoration: none;"><%= placeContactPhone %></a></td>
  </tr>
  <% } %>
</table>
<% } %>

<div class="feature-box">
  <strong>Student Reminder:</strong> Please bring a valid government-issued ID, and a card to put on file for incidentals.
</div>

<%- include('./partials/deadline-button', { url: dashboardUrl, label: 'View Your Bookings' }) %>

<p style="text-align: center; color: #6b7280;">Thank you for choosing <%= appName %>!</p>

<%- include('./partials/deadline-foot', { appName: appName }) %>
