<%- include('./partials/deadline-head', {
  title: 'Payout Sent',
  heading: 'Your payout is on its way!',
  badgeText: '💰 Payout Sent'
}) %>

<p class="intro">Hello,</p>

<p>Great news! Your payout for the booking at <strong><%= placeName %></strong> has been processed.</p>

<table class="detail-table" role="presentation" cellpadding="0" cellspacing="0" border="0">
  <tr><th colspan="2">Booking Details</th></tr>
  <tr><td class="label">Guest</td><td class="value"><%= studentName %></td></tr>
  <tr><td class="label">Check-in</td><td class="value"><%= checkInDate %></td></tr>
  <tr><td class="label">Check-out</td><td class="value"><%= checkOutDate %></td></tr>
  <tr><td class="label">Total Nights</td><td class="value"><%= totalNights %></td></tr>
</table>

<table class="detail-table" role="presentation" cellpadding="0" cellspacing="0" border="0">
  <tr><th colspan="2">Payment Breakdown</th></tr>
  <tr><td class="label">Student Paid (Total)</td><td class="value">$<%= totalAmount %></td></tr>
  <tr><td class="label" style="color: #dc2626;">Platform Commission (<%= commissionRate %>%)</td><td class="value" style="color: #dc2626;">- $<%= platformCommission %></td></tr>
  <tr class="total-row"><td>Your Payout</td><td class="value">$<%= payableToHotel %></td></tr>
</table>

<% if (payoutMethod) { %>
<p><strong>Payout Method:</strong> <%= payoutMethod %></p>
<% } %>

<% if (payoutNotes) { %>
<div class="feature-box"><strong>Notes:</strong> <%= payoutNotes %></div>
<% } %>

<div class="success-box"><strong>✓ Payout Sent:</strong> <%= paidAt %></div>

<p style="color: #6b7280; font-size: 14px;">If you have any questions about this payout, please contact our support team.</p>
<p>Thank you for partnering with us!</p>

<%- include('./partials/deadline-foot', { appName: appName }) %>
