<%- include('./partials/deadline-head', {
  title: 'Account Not Approved',
  heading: 'Your application needs another look.',
  badgeText: 'Not Approved'
}) %>

<p class="intro">Hi <%= name %>,</p>

<p>We weren't able to approve your <%= appName %> account application.</p>

<% if (rejectionReason) { %>
<div class="reason-box"><strong>Reason:</strong> <%= rejectionReason %></div>
<% } %>

<p>If you believe this was a mistake, or have questions, just reply to this email.</p>

<% if (loginUrl) { %>
<%- include('./partials/deadline-button', { url: loginUrl, label: 'Resubmit Your ID' }) %>
<p style="text-align: center; color: #991b1b; font-size: 13px; margin-top: -8px;">
  <em>This link expires in 1 day.</em>
</p>
<% } %>

<%- include('./partials/deadline-foot', { appName: appName }) %>
