<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>New Booking Confirmed</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f4;font-family:Arial,Helvetica,sans-serif;color:#111827;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f4f4f4;">
<tr><td align="center" style="padding:20px 10px;">

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:720px;width:100%;background:#ffffff;border-collapse:separate;border-spacing:0;">

  <!-- HEADER -->
  <tr><td style="background:#111111;padding:24px 28px 18px;color:#ffffff;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr>
      <td align="left" style="font-family:Georgia,'Times New Roman',serif;color:#d6a73a;font-size:30px;letter-spacing:3px;">DEADLINE</td>
      <td align="right" style="color:#ffffff;font-size:11px;letter-spacing:4px;text-transform:uppercase;">HOTEL PARTNER</td>
    </tr></table>
  </td></tr>

  <tr><td align="center" style="background:#171717;padding:34px 24px 28px;color:#ffffff;">
    <div style="font-family:Georgia,'Times New Roman',serif;font-size:36px;line-height:1.15;margin-bottom:14px;">New Booking Confirmed</div>
    <div style="font-size:12px;letter-spacing:7px;text-transform:uppercase;margin-bottom:16px;">YOU HAVE A NEW GUEST!</div>
    <div style="width:54px;height:2px;background:#d6a73a;margin:0 auto;"></div>
  </td></tr>

  <!-- INTRO -->
  <tr><td style="padding:26px 28px 16px;">
    <div style="font-size:17px;margin-bottom:10px;">Great news,</div>
    <div style="font-size:16px;line-height:1.6;">
      You have received a new confirmed booking for <strong><%= hotelName %></strong>.
      <% if (commissionOnly) { %>
      The guest&rsquo;s card details have been securely saved, and Deadline&rsquo;s 7% commission has been charged.
      <strong>Your property will collect the remaining balance and applicable taxes at check-in.</strong>
      <% } else { %>
      The guest has paid in full through Deadline, and your payout will follow per your agreement. The guest&rsquo;s card is securely on file.
      <% } %>
    </div>
  </td></tr>

  <!-- BOOKING CARD -->
  <tr><td style="padding:0 28px 22px;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;">
      <tr><td colspan="2" style="padding:18px 20px;background:#f7f8fa;">
        <table role="presentation" width="100%"><tr>
          <td style="font-size:13px;font-weight:bold;letter-spacing:4px;">BOOKING DETAILS</td>
          <td align="right" style="font-size:13px;color:#475569;line-height:1.5;">Booking ID: <strong><%= bookingId %></strong><br>Booked on: <%= bookedAt %></td>
        </tr></table>
      </td></tr>

      <tr>
        <!-- LEFT -->
        <td width="50%" valign="top" style="padding:22px;border-right:1px solid #e5e7eb;">
          <div style="margin-bottom:16px;"><div style="font-size:13px;color:#64748b;">Guest Name</div><div style="font-size:15px;font-weight:bold;"><%= guestName %></div></div>
          <div style="margin-bottom:16px;"><div style="font-size:13px;color:#64748b;">Guest Email</div><a href="mailto:<%= guestEmail %>" style="color:#1264d8;text-decoration:underline;font-size:15px;"><%= guestEmail %></a></div>
          <% if (guestPhone) { %>
          <div style="margin-bottom:16px;"><div style="font-size:13px;color:#64748b;">Phone Number</div><a href="tel:<%= guestPhone %>" style="color:#111827;text-decoration:none;font-size:15px;"><%= guestPhone %></a></div>
          <% } %>
          <div style="margin-bottom:16px;">
            <div style="font-size:13px;color:#64748b;">Check-in</div>
            <div style="font-size:15px;font-weight:bold;margin-bottom:4px;"><%= checkInFormatted %></div>
            <a href="<%= googleCalendarUrl %>" target="_blank" style="color:#1264d8;text-decoration:underline;font-size:14px;">Add reservation to Google Calendar</a>
          </div>
          <div style="margin-bottom:16px;"><div style="font-size:13px;color:#64748b;">Check-out</div><div style="font-size:15px;font-weight:bold;"><%= checkOutFormatted %></div></div>
          <div style="margin-bottom:16px;"><div style="font-size:13px;color:#64748b;">Total Nights</div><div style="font-size:15px;"><%= totalNights %></div></div>
          <div style="margin-bottom:16px;"><div style="font-size:13px;color:#64748b;">Guests</div><div style="font-size:15px;"><%= guestCount %></div></div>
          <div><div style="font-size:13px;color:#64748b;">Room type</div><div style="font-size:15px;font-weight:bold;">Selected by hotel</div></div>
        </td>

        <!-- RIGHT -->
        <td width="50%" valign="top" style="padding:22px;">
          <div style="font-size:13px;font-weight:bold;letter-spacing:4px;margin-bottom:24px;">PAYMENT SUMMARY</div>
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
            <tr><td style="padding-bottom:12px;font-size:14px;">Confirmed Room Rate</td><td align="right" style="padding-bottom:12px;font-size:14px;">$<%= roomRate %></td></tr>
            <% if (commissionOnly) { %>
            <tr><td style="padding-bottom:14px;font-size:14px;">&minus; 7% Commission (charged to guest)</td><td align="right" style="padding-bottom:14px;font-size:14px;">&minus;$<%= commissionAmount %></td></tr>
            <tr><td style="background:#f7f8fa;padding:14px 10px;font-size:15px;font-weight:bold;">Amount Due to Hotel</td><td align="right" style="background:#f7f8fa;padding:14px 10px;font-size:20px;font-weight:bold;">$<%= hotelBalance %></td></tr>
            <tr><td style="padding-top:14px;font-size:14px;">+ Occupancy Tax</td><td align="right" style="padding-top:14px;font-size:14px;">Collected at check-in</td></tr>
            <% } else { %>
            <tr><td style="background:#f7f8fa;padding:14px 10px;font-size:15px;font-weight:bold;">Charged to guest</td><td align="right" style="background:#f7f8fa;padding:14px 10px;font-size:20px;font-weight:bold;">$<%= roomRate %></td></tr>
            <tr><td colspan="2" style="padding-top:12px;font-size:13px;color:#475569;line-height:1.5;">Paid in full through Deadline. Your payout follows per your agreement.</td></tr>
            <% } %>
          </table>

          <% if (commissionOnly) { %>
          <div style="background:#e8f8ef;border-radius:10px;padding:20px;margin-top:24px;color:#075b35;">
            <div style="font-size:27px;font-weight:bold;line-height:1.15;margin-bottom:16px;">You collect<br>$<%= hotelBalance %> + tax</div>
            <div style="border-top:1px solid #91c9a9;padding-top:15px;font-size:14px;line-height:1.5;color:#183e30;"><strong>Pro tip:</strong> send the guest your PMS&rsquo;s payment link before arrival to settle the balance and attach their CC.</div>
          </div>
          <% } %>
        </td>
      </tr>
    </table>
  </td></tr>

  <!-- NEXT STEPS -->
  <tr><td style="padding:0 28px 22px;">
    <div style="background:#f4f7fb;border-radius:12px;padding:22px 24px;">
      <div style="font-size:13px;font-weight:bold;letter-spacing:4px;margin-bottom:18px;">WHAT HAPPENS NEXT?</div>
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
        <% if (commissionOnly) { %>
        <tr><td valign="top" width="30" style="padding-bottom:18px;font-weight:bold;">1</td><td style="padding-bottom:18px;font-size:14px;line-height:1.55;">The guest&rsquo;s card has only been charged our 7% commission. <strong>You are responsible for collecting the remaining 93% plus applicable taxes.</strong></td></tr>
        <tr><td valign="top" width="30" style="padding-bottom:18px;font-weight:bold;">2</td><td style="padding-bottom:18px;font-size:14px;line-height:1.55;">In the event of a no-show, you may charge the first night&rsquo;s room rate after notifying Deadline within 72 hours of the scheduled arrival. The hotel is responsible for any chargebacks resulting from a no-show charge.</td></tr>
        <tr><td valign="top" width="30" style="padding-bottom:18px;font-weight:bold;">3</td><td style="padding-bottom:18px;font-size:14px;line-height:1.55;">You&rsquo;ll receive a separate email if there are any changes or cancellations.</td></tr>
        <tr><td valign="top" width="30" style="font-weight:bold;">4</td><td style="font-size:14px;line-height:1.55;">If you experience an issue with a guest, please report it to us with a brief explanation. Deadline may review the guest&rsquo;s account and revoke their membership when appropriate.</td></tr>
        <% } else { %>
        <tr><td valign="top" width="30" style="padding-bottom:18px;font-weight:bold;">1</td><td style="padding-bottom:18px;font-size:14px;line-height:1.55;">The guest has paid in full through Deadline. Your payout will be sent per your agreement.</td></tr>
        <tr><td valign="top" width="30" style="padding-bottom:18px;font-weight:bold;">2</td><td style="padding-bottom:18px;font-size:14px;line-height:1.55;">You&rsquo;ll receive a separate email if there are any changes or cancellations.</td></tr>
        <tr><td valign="top" width="30" style="font-weight:bold;">3</td><td style="font-size:14px;line-height:1.55;">If you experience an issue with a guest, please report it to us with a brief explanation. Deadline may review the guest&rsquo;s account and revoke their membership when appropriate.</td></tr>
        <% } %>
      </table>
    </div>
  </td></tr>

  <!-- CTA -->
  <tr><td align="center" style="padding:0 28px 26px;">
    <a href="<%= dashboardUrl %>" style="display:inline-block;background:#e7b53c;color:#111111;font-size:16px;font-weight:bold;text-decoration:none;padding:15px 36px;border-radius:8px;">View Booking in Dashboard &rarr;</a>
  </td></tr>

  <!-- FOOTER -->
  <tr><td style="border-top:1px solid #e5e7eb;padding:24px 28px 30px;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr>
      <td valign="top">
        <div style="font-family:Georgia,'Times New Roman',serif;color:#d6a73a;font-size:24px;letter-spacing:3px;">DEADLINE</div>
        <div style="font-size:8px;letter-spacing:3px;color:#475569;margin-top:3px;">LIFE'S SHORT. TRAVEL NOW.</div>
      </td>
      <td align="right" valign="top" style="font-size:13px;line-height:1.55;color:#475569;">
        Partner Support<br>
        <a href="mailto:hotels@deadlinetravel.com" style="color:#c49322;">hotels@deadlinetravel.com</a><br>
        <a href="tel:+12139737741" style="color:#111827;text-decoration:none;">213.973.7741</a> (text or call)
      </td>
    </tr></table>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
