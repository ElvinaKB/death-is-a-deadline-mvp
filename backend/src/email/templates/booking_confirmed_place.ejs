<%- include('./partials/deadline-head', {
  title: 'New Booking Received',
  heading: 'You have a new guest!',
  badgeText: 'New Booking'
}) %>

<p class="intro">Hello,</p>

<p>Great news &mdash; you have received a new confirmed booking for <strong><%= placeName %></strong>. The guest's payment has been pre-authorized and will be captured upon check-in.</p>

<table class="detail-table" role="presentation" cellpadding="0" cellspacing="0" border="0">
  <tr><td class="label">Guest</td><td class="value"><%= studentName %></td></tr>
  <tr><td class="label">Guest Email</td><td class="value"><%= studentEmail %></td></tr>
  <tr><td class="label">Check-in</td><td class="value"><%= checkInDate %></td></tr>
  <tr><td class="label">Check-out</td><td class="value"><%= checkOutDate %></td></tr>
  <tr><td class="label">Total Nights</td><td class="value"><%= totalNights %></td></tr>
  <tr><td class="label">Price per Night</td><td class="value">$<%= bidPerNight %></td></tr>
  <tr class="total-row"><td>Total Amount</td><td class="value">$<%= totalAmount %></td></tr>
</table>

<div class="success-box">
  <strong>Payment Status:</strong> Pre-authorized. Payment will be captured upon guest check-in.
</div>

<%- include('./partials/deadline-button', { url: dashboardUrl, label: 'View Dashboard' }) %>

<p style="text-align: center; color: #6b7280;">Thank you for partnering with <%= appName %>!</p>

<%- include('./partials/deadline-foot', { appName: appName }) %>
