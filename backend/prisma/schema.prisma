generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("SUPABASE_CONNECTION_STRING")
  directUrl = env("SUPABASE_DIRECT_URL")
  schemas   = ["auth", "public"]
}

model Place {
  id                     String            @id @default(uuid())
  slug                   String            @unique @db.VarChar(100)
  name                   String
  shortDescription       String            @db.VarChar(150)
  fullDescription        String
  city                   String
  country                String
  address                String
  timezone               String?           @db.VarChar(64)
  email                  String?
  reservationPhone       String?           @map("reservation_phone")
  keywords               String[]          @default([])
  latitude               Float?
  longitude              Float?
  accommodationType      AccommodationType
  retailPrice            Float
  minimumBid             Float
  thresholdPricingMode   ThresholdPricingMode @default(UNIFORM) @map("threshold_pricing_mode")
  minimumBidByDayOfWeek  Float[]           @default([]) @map("minimum_bid_by_day_of_week")
  autoAcceptAboveMinimum Boolean           @default(true)
  blackoutDates          String[]          @default([])
  allowedDaysOfWeek      Int[]             @default([0, 1, 2, 3, 4, 5, 6]) @map("allowed_days_of_week")
  maxInventory           Int               @default(1) @map("max_inventory")
  // Mandatory, non-waivable per-night fees the hotel charges (resort fee,
  // and/or parking when parking is not optional). 0 = none. Per the FTC
  // Junk Fees Rule (effective 2025-05-12) and California SB 478/AB 537,
  // any mandatory fee must be included in the total price shown before
  // checkout, not collected separately at check-in — unlike government
  // taxes and genuinely optional charges (e.g. optional parking), which
  // may still be disclosed and collected separately.
  mandatoryResortFeeAmount  Float          @default(0) @map("mandatory_resort_fee_amount")
  mandatoryParkingFeeAmount Float          @default(0) @map("mandatory_parking_fee_amount")
  // Optional listing-page media, editable from the Places dashboard so they
  // can be swapped out later without a code change. verticalVideoUrl expects
  // a direct link to an MP4/WebM file (rendered in a plain <video> tag) —
  // not a YouTube/Instagram/TikTok page link.
  verticalVideoUrl          String?        @map("vertical_video_url")
  neighborhoodGuideText     String?        @map("neighborhood_guide_text")
  neighborhoodGuideImageUrl String?        @map("neighborhood_guide_image_url")
  status                 PlaceStatus       @default(DRAFT)
  // Affiliate/referral: who referred this hotel + when it started (the 1-year
  // referral window runs from referralStartedAt).
  referrerId             String?           @map("referrer_id")
  referrer               Referrer?         @relation("PlaceReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  referralStartedAt      DateTime?         @map("referral_started_at")
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  bids                   Bid[]
  images                 PlaceImage[]
  testimonials           Testimonial[]
  reviewPlatforms        ReviewPlatform[]
  channelAvailability    PlaceChannelAvailability[]
  views                  PlaceView[]
  thresholdState         PlaceThresholdState[]

  @@map("places")
  @@schema("public")
}

// Affiliate/referrer: a person who refers hotels to Deadline and earns a share
// of commission on that hotel's bookings for a fixed window (default 12 months).
// A referrer is also a normal traveler account (userId -> auth users), so they
// can bid too. Raw tax IDs (SSN/EIN) are intentionally NOT stored here — the W-9
// TIN must be handled by a secure vault / tax-payout service before real payouts.
model Referrer {
  id                   String    @id @default(uuid())
  userId               String    @unique @map("user_id") @db.Uuid
  displayName          String    @map("display_name")
  email                String
  // Percent of each referred booking's total that the referrer earns
  // (3.5% = 50% of Deadline's 7% commission).
  splitPercent         Float     @default(3.5) @map("split_percent")
  referralWindowMonths Int       @default(12) @map("referral_window_months")
  // Tax status gates payout: "pending" until a W-9 is on file, then "submitted".
  taxStatus            String    @default("pending") @map("tax_status")
  taxLegalName         String?   @map("tax_legal_name")
  taxClassification    String?   @map("tax_classification")
  taxAddress           String?   @map("tax_address")
  status               String    @default("active")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  referredPlaces       Place[]   @relation("PlaceReferrer")

  @@map("referrers")
  @@schema("public")
}

// First-party browse events: a logged-in traveler opened a hotel's listing.
// Consent-gated on the client, lean by design (no user-agent/scroll). Powers
// the "explored but didn't bid" signal (view -> bid conversion per profile).
model PlaceView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  placeId   String   @map("place_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([placeId])
  @@index([createdAt(sort: Desc)])
  @@map("place_views")
  @@schema("public")
}

// Per-date channel availability pushed by Cloudbeds/myallocator via ARIUpdate.
// Stored at the room/place level (Cloudbeds only supports room-level
// availability, and Deadline models one bookable unit per Place). Drives the
// effective per-date cap: available = min(Place.maxInventory, units) - accepted
// bids. Rows are absent for dates Cloudbeds hasn't pushed (or non-connected
// hotels), in which case Place.maxInventory alone applies.
model PlaceChannelAvailability {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placeId   String   @map("place_id")
  date      DateTime @map("date") @db.Date
  units     Int
  source    String   @default("cloudbeds") @db.VarChar(20)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([placeId, date])
  @@index([placeId, date])
  @@map("place_channel_availability")
  @@schema("public")
}

// Rolling state for the dynamic ("flickering") bid threshold: the effective
// premium currently sitting on top of a place's hidden floor (minimumBid /
// minimumBidByDayOfWeek) for one specific night. Each bid evaluation for that
// night nudges currentPremium up or down within a bounded step so the number
// a traveler needs to clear drifts over time instead of staying fixed and
// shareable. See dynamicPricing.service.ts.
model PlaceThresholdState {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placeId        String   @map("place_id")
  date           DateTime @map("date") @db.Date
  currentPremium Float    @map("current_premium")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  place          Place    @relation(fields: [placeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([placeId, date])
  @@index([placeId, date])
  @@map("place_threshold_state")
  @@schema("public")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String?  @map("full_name")
  phone     String?
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
  @@schema("public")
}

model WaitlistSignup {
  id                String    @id @default(uuid())
  fullName          String    @map("full_name")
  email             String    @unique
  phone             String?
  source            String?
  marketingConsent  Boolean   @default(true) @map("marketing_consent")
  welcomeEmailSentAt DateTime? @map("welcome_email_sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("waitlist_signups")
  @@schema("public")
}

// A hotel's public "Ready to Join?" application. Captured as a lead only —
// an admin reviews each one, curates the profile, provisions the Place, and
// sends the existing hotel invite; this table does not auto-create anything.
model HotelApplication {
  id          String   @id @default(uuid())
  hotelName   String   @map("hotel_name")
  address     String
  phone       String
  email       String
  daysOfWeek  Int[]    @default([]) @map("days_of_week") // 0=Sun..6=Sat, matches Place.allowedDaysOfWeek
  roomsPerDay Int      @map("rooms_per_day")
  secretPrice Decimal? @map("secret_price") @db.Decimal(10, 2)
  pms         String[] @default([]) // e.g. ["cloudbeds","siteminder","other"]
  pmsOther    String?  @map("pms_other")
  status      String   @default("new") // new | contacted | listed (admin-managed later)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("hotel_applications")
  @@schema("public")
}

model Testimonial {
  id         String   @id @default(uuid())
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeId    String   @map("place_id")
  rating     Int
  title      String
  content    String
  author     String
  authorRole String?  @map("author_role")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([placeId])
  @@map("testimonials")
  @@schema("public")
}

model ReviewPlatform {
  id          String       @id @default(uuid())
  place       Place        @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeId     String       @map("place_id")
  name        String
  rating      Decimal      @db.Decimal(3, 2)
  reviewCount Int          @map("review_count")
  url         String
  source      String
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@unique([placeId, source])
  @@index([placeId])
  @@index([source])
  @@map("review_platforms")
  @@schema("public")
}

enum ReviewSource {
  google
  yelp

  @@schema("public")
}

model PlaceImage {
  id      String @id @default(uuid())
  url     String
  order   Int    @default(0)
  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@map("place_images")
  @@schema("public")
}

model Bid {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placeId            String     @map("place_id")
  studentId          String     @map("student_id") @db.Uuid
  checkInDate        DateTime   @map("check_in_date") @db.Date
  checkOutDate       DateTime   @map("check_out_date") @db.Date
  bidPerNight        Decimal    @map("bid_per_night") @db.Decimal(10, 2)
  totalNights        Int        @map("total_nights")
  totalAmount        Decimal    @map("total_amount") @db.Decimal(10, 2)
  // Mandatory fee snapshot (resort/parking) at booking time, in addition to
  // totalAmount (the room rate). Charged to the guest, passed through to the
  // hotel in full, and excluded from platformCommission's basis. Snapshotted
  // here rather than read live from Place so a hotel's later fee changes
  // never alter what an existing bid was booked and charged at.
  mandatoryFeeAmount Decimal    @default(0) @map("mandatory_fee_amount") @db.Decimal(10, 2)
  platformCommission Decimal?   @map("platform_commission") @db.Decimal(10, 2)
  payableToHotel     Decimal?   @map("payable_to_hotel") @db.Decimal(10, 2)
  payoutMethod       String?    @map("payout_method") @db.VarChar(50)
  isPaidToHotel      Boolean    @default(false) @map("is_paid_to_hotel")
  paidToHotelAt      DateTime?  @map("paid_to_hotel_at") @db.Timestamptz(6)
  payoutNotes        String?    @map("payout_notes")
  status             bid_status @default(PENDING)
  rejectionReason    String?    @map("rejection_reason")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  place              Place      @relation(fields: [placeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users              users      @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payment            Payment?

  @@index([createdAt(sort: Desc)], map: "idx_bids_created_at")
  @@index([placeId], map: "idx_bids_place_id")
  @@index([status], map: "idx_bids_status")
  @@index([studentId], map: "idx_bids_student_id")
  @@map("bids")
  @@schema("public")
}

model Payment {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bidId                 String         @unique @map("bid_id") @db.Uuid
  studentId             String         @map("student_id") @db.Uuid
  amount                Decimal        @db.Decimal(10, 2)
  currency              String         @default("usd") @db.VarChar(3)
  stripePaymentIntentId String?        @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  stripeCustomerId      String?        @map("stripe_customer_id") @db.VarChar(255)
  stripePaymentMethodId String?        @map("stripe_payment_method_id") @db.VarChar(255)
  stripeClientSecret    String?        @map("stripe_client_secret") @db.VarChar(255)
  status                payment_status @default(PENDING)
  authorizedAt          DateTime?      @map("authorized_at") @db.Timestamptz(6)
  capturedAt            DateTime?      @map("captured_at") @db.Timestamptz(6)
  cancelledAt           DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  refundedAt            DateTime?      @map("refunded_at") @db.Timestamptz(6)
  stripeRefundId        String?        @unique @map("stripe_refund_id") @db.VarChar(255)
  failedAt              DateTime?      @map("failed_at") @db.Timestamptz(6)
  expiresAt             DateTime?      @map("expires_at") @db.Timestamptz(6)
  failureReason         String?        @map("failure_reason")
  adminNotes            String?        @map("admin_notes")
  metadata              Json?          @default("{}")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bid                   Bid            @relation(fields: [bidId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student               users          @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([bidId], map: "idx_payments_bid_id")
  @@index([studentId], map: "idx_payments_student_id")
  @@index([status], map: "idx_payments_status")
  @@index([stripePaymentIntentId], map: "idx_payments_stripe_payment_intent_id")
  @@index([createdAt(sort: Desc)], map: "idx_payments_created_at")
  @@map("payments")
  @@schema("public")
}

model StripeEvent {
  id        String   @id @db.VarChar(255)
  type      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "idx_stripe_events_created_at")
  @@map("stripe_events")
  @@schema("public")
}

